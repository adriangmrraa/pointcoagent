# --- Core API Keys ---
OPENAI_API_KEY=sk-...
# OpenRouter revende los mismos modelos de OpenAI (API compatible). Ambas keys conviven.
# OPENAI_API_KEY NO se toca: Whisper (audios) sigue necesitando OpenAI directo.
OPENROUTER_API_KEY=sk-or-v1-...
# El nombre del modelo decide el proveedor:
#   "gpt-4.1-mini"         -> OpenAI directo (default / rollback, sin redeploy)
#   "openai/gpt-4.1-mini"  -> OpenRouter (paga OpenRouter, mismo modelo)
LLM_MODEL=gpt-4.1-mini
# --- Security & Networking ---
INTERNAL_API_TOKEN=your_secure_token_here
CORS_ALLOWED_ORIGINS=https://your-platform-ui.host,http://localhost:3000

# --- WhatsApp / YCloud ---
YCLOUD_API_KEY=...
YCLOUD_WEBHOOK_SECRET=...
# En el whatsapp_service, configurar:
# ORCHESTRATOR_SERVICE_URL=http://orchestrator-service:8000

# --- Database & Cache ---
REDIS_URL=redis://redis:6379
POSTGRES_DSN=postgres://user:pass@db:5432/dbname

# --- Tienda Nube (Store Specific) ---
TIENDANUBE_STORE_ID=1234567
TIENDANUBE_ACCESS_TOKEN=tu_token_de_tienda_nube

# --- Whitelabel / Branding (Identidad del Bot) ---
# Estas variables personalizan el System Prompt automáticamente
STORE_NAME="Pointe Coach"
STORE_LOCATION="Paraná, Entre Ríos, Argentina"
STORE_DESCRIPTION="tienda de artículos de danza clásica y contemporánea"
STORE_WEBSITE="https://www.pointecoach.shop/"
SHIPPING_PARTNERS="Andreani y Correo Argentino"

# Conocimiento del Catálogo para normalización (categorías, marcas, términos técnicos)
STORE_CATALOG_KNOWLEDGE="- Accesorios: Metatarsianas, Elásticos, Cintas, Punteras.\n- Medias: Convertibles, Socks.\n- Zapatillas: Punta, Media punta.\n- Marcas: Grishko, Capezio."

# --- Handoff & SMTP (Human Handoff) ---
HANDOFF_EMAIL=destinatario@tienda.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu@email.com
SMTP_PASS=password_de_aplicacion
SMTP_SECURITY=SSL

# --- MCP (n8n Bridge) ---
MCP_URL=https://n8n-n8n.example.host/mcp/uuid

# --- Tiempos del bot (WhatsApp Service) ---
# Segundos que espera agrupando mensajes seguidos del usuario antes de responder
DEBOUNCE_SECONDS=5
# Pausas de "humanización" del envío (en segundos)
DELAY_IMAGE_SECONDS=1.5
DELAY_TEXT_SECONDS=0.8
DELAY_BETWEEN_BUBBLES_SECONDS=1.0